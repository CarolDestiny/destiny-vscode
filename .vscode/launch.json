{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug destiny (GCC x64)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/output/destiny.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "D:\\cpp\\toolchains\\gcc\\x64\\bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/cpp/toolchains/gcc/x64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: Build (GCC x64 Debug)"
        }
    ]
}
